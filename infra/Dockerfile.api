FROM python:3.12-slim

WORKDIR /app

# System dependencies for weasyprint PDF generation
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc libpq-dev libffi-dev libcairo2 libpango-1.0-0 \
    libpangocairo-1.0-0 libgdk-pixbuf2.0-0 libssl-dev \
    curl && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY . .

RUN mkdir -p reports/output data/playbooks

# Non-root user
RUN groupadd -r shadowhound && useradd -r -g shadowhound shadowhound
RUN chown -R shadowhound:shadowhound /app
USER shadowhound

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1
